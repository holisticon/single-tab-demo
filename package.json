{
  "name": "single-window-webapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "central-tasklist",
    "business-application"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "npm start --workspace central-tasklist",
    "start:business-application": "npm start --workspace business-application",
    "check": "npm run check --workspaces",
    "test": "npm test --workspace central-tasklist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
